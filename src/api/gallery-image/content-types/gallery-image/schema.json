{
  "kind": "collectionType",
  "collectionName": "gallery_images",
  "info": {
    "singularName": "gallery-image",
    "pluralName": "gallery-images",
    "displayName": "Gallery Image"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "alt": {
      "type": "string",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "default": "climbing",
      "enum": [
        "climbing",
        "boulder",
        "training",
        "events"
      ]
    },
    "order": {
      "type": "integer",
      "default": 0
    }
  }
}
